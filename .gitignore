# Spec-driven-development artifacts are kept local only
.specify/
.claude/
specs/
CLAUDE.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Model weights, engines, footage and benchmark outputs (never redistributed)
*.pth
*.pt
*.safetensors
*.ckpt
*.onnx
*.engine
*.plan
*.mp4
*.mov
*.exr
/weights/
/footage/
/outputs/

# Benchmark harness (bench/): vendored CorridorKey, env, large outputs
bench/vendor/
bench/.venv/
outputs/
footage/
*.onnx.data
bench/results/*/frames/

# OBS plugin (plugin/): build trees, packaged output, e2e artefacts
plugin/build*/
plugin/release/
plugin/.deps/
plugin/tests/e2e/.artifacts/
plugin/tests/e2e/.obs-*/
plugin/cmake/.CMakeBuildNumber
*.engine
*.onnx
*.npy
